# Server-only Vercel variables. Never expose these through VITE_* names.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
LEAD_WEBHOOK_SECRET=replace-with-a-long-random-secret
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret

# Public site key intentionally embedded in the frontend build.
VITE_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
